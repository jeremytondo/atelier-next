#!/usr/bin/env bash
# The atelier command: install, doctor, and uninstall for a Homebrew-installed
# Atelier. Runtime diagnosis reads disk and Homebrew; installation quits HS2
# gracefully before changing its preferences, then starts it again.
# `atelier install` is what the cask's post-install runs; it is safe to rerun.
set -euo pipefail

bundle=net.tenshu.Hammerspoon-2
app_name='Hammerspoon 2'
app=${ATELIER_HS2_APP:-/Applications/$app_name.app}
prefix=${ATELIER_PREFIX:-$(brew --prefix 2>/dev/null || echo /opt/homebrew)}
share="$prefix/share/atelier"
config_dir="$HOME/.config/atelier"
init="$config_dir/init.js"
tap=jeremytondo/atelier
channel=$(jq -r .channel "$share/version.json" 2>/dev/null || echo unknown)
if [[ $channel == unknown || $channel == null || $channel == local ]]; then
  channel=stable
  if brew list --cask atelier@dev > /dev/null 2>&1; then channel=dev; fi
fi
atelier_cask=atelier
hs2_cask=hammerspoon2
if [[ $channel == dev ]]; then atelier_cask=atelier@dev; hs2_cask=hammerspoon2@dev; fi

usage() {
  cat <<'USAGE'
usage: atelier install    Point Hammerspoon 2 at ~/.config/atelier/init.js, seed it once,
                          add the login item, and restart Hammerspoon 2 if running
       atelier repair     Back up init.js, restore the shipped defaults, and run installation
       atelier doctor     Check the installation and print what to fix
       atelier uninstall  Remove the login item and the Hammerspoon 2 settings Atelier wrote;
                          the init file and the Homebrew packages stay
       atelier version    Print the installed package version
USAGE
}
die() { echo "atelier: $*" >&2; exit 1; }
hs2_running() { pgrep -x "$app_name" > /dev/null; }
hs2_build() { defaults read "$app/Contents/Info" CFBundleVersion 2>/dev/null || true; }
login_items() { osascript -e 'tell application "System Events" to get the name of every login item' 2>/dev/null | tr ',' '\n' | sed -E 's/^ +| +$//g'; }
login_item_present() { login_items | grep -qx "$app_name"; }
setting() { defaults read "$bundle" "$1" 2>/dev/null || true; }

config_path() {
  local path
  path=$(setting configLocation)
  case "$path" in
    \~/*) printf '%s/%s\n' "$HOME" "${path#\~/}" ;;
    *) printf '%s\n' "$path" ;;
  esac
}

quit_hs2() {
  hs2_running || return 0
  echo "Quitting $app_name before changing its settings…"
  osascript -e "tell application id \"$bundle\" to quit" > /dev/null \
    || die "Could not quit $app_name. Quit it from its menu, then rerun atelier install."
  local attempt
  for ((attempt = 0; attempt < 100; attempt++)); do
    hs2_running || return 0
    sleep 0.1
  done
  die "$app_name is still running; settings were not changed. Quit it, then rerun atelier install."
}

init_requires_atelier() {
  local escaped_share
  escaped_share=$(printf '%s' "$share" | sed 's/[][\\.^$*+?(){}|]/\\&/g')
  grep -Eq "require[[:space:]]*\([[:space:]]*[\"']${escaped_share}[\"'][[:space:]]*\)" "$init"
}

install() {
  local repair=${1:-false} config_warning=false backup staged
  [[ -d $app ]] || die "$app_name is not installed; run: brew install --cask $tap/$hs2_cask"
  [[ $(sw_vers -productVersion | cut -d. -f1) -ge 27 ]] || die 'Atelier requires macOS 27 or later.'
  [[ -x $share/atelier-providers ]] || die "$share is incomplete; reinstall with: brew reinstall --cask $tap/$atelier_cask"
  if [[ $repair == false && -f $init ]] && ! init_requires_atelier; then
    echo "Existing $init: could not find the Atelier import." >&2
    if [[ -t 0 && -t 1 ]]; then
      local answer
      read -r -p 'Back up this file and replace it with Atelier defaults? [y/N] ' answer || answer=''
      case "$answer" in y|Y|yes|YES) repair=true ;; esac
    fi
  fi
  # The app observes and writes these preferences too. Let it finish saving
  # before changing them, so its cached values cannot overwrite installation.
  quit_hs2
  defaults write "$bundle" configLocation -string "$init"
  defaults write "$bundle" hasCompletedOnboarding -bool true
  defaults write "$bundle" dockMenuBehaviour -string menuBar
  defaults write "$bundle" SUEnableAutomaticChecks -bool false
  [[ $(config_path) == "$init" && $(setting hasCompletedOnboarding) == 1 \
    && $(setting dockMenuBehaviour) == menuBar && $(setting SUEnableAutomaticChecks) == 0 ]] \
    || die 'Hammerspoon 2 settings were not saved; rerun atelier install.'
  mkdir -p "$config_dir"
  if [[ $repair == true && ( -e $init || -L $init ) ]]; then
    [[ -f $init ]] || die "$init is not a readable regular file; repair left it untouched."
    mkdir -p "$config_dir/backups"
    backup=$(mktemp -d "$config_dir/backups/init.XXXXXX")
    cp -pL "$init" "$backup/init.js" || die "Could not back up $init; repair left it untouched."
    echo "Backed up $init to $backup/init.js"
  fi
  if [[ $repair == true || ! -e $init ]]; then
    staged=$(mktemp "$config_dir/.init.XXXXXX")
    if ! sed "s|/opt/homebrew/share/atelier|$share|" "$share/init.js" > "$staged" || ! mv -f "$staged" "$init"; then
      rm -f "$staged"
      die "Could not write the default config. Any backup is in $config_dir/backups."
    fi
    echo "Seeded $init"
  elif ! init_requires_atelier; then
    config_warning=true
    echo "Warning: Kept existing $init, but could not find a require for $share." >&2
    echo "Add: const atelier = require(\"$share\"); before atelier.start(...), then choose Reload Config in $app_name." >&2
    echo "Or run atelier repair to back up this file and restore the default configuration." >&2
  fi
  if ! login_item_present; then
    osascript -e "tell application \"System Events\" to make login item at end with properties {path:\"$app\", hidden:false}" > /dev/null \
      || echo 'Could not add the login item; allow this terminal to control System Events, then rerun atelier install.' >&2
  fi
  open -a "$app"
  echo "Started $app_name with $init."
  if [[ $config_warning == true ]]; then
    echo "Setup needs attention: fix the config above or run atelier repair." >&2
  else
    echo "Check the Atelier menu for startup status. It shows Running when shortcuts are ready."
    echo "If waiting for Accessibility, use Open Accessibility Settings in that menu; startup resumes after access is granted."
  fi
}

failed=0
ok() { printf 'ok    %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; failed=1; }
unknown() { printf '?     %s\n' "$*"; }
doctor() {
  local expected actual
  if [[ $(sw_vers -productVersion | cut -d. -f1) -ge 27 && $(uname -m) == arm64 ]]; then
    ok "macOS $(sw_vers -productVersion) on Apple silicon"
  else
    fail "Atelier needs macOS 27 or later on Apple silicon; this is macOS $(sw_vers -productVersion) on $(uname -m)"
  fi
  if [[ -f $share/hammerspoon2.json && -x $share/atelier-providers ]]; then
    ok "Package installed in $share ($(jq -r .version "$share/version.json" 2>/dev/null || echo unknown version))"
  else
    fail "Package missing or incomplete in $share; run: brew reinstall --cask $tap/$atelier_cask"
  fi
  if [[ -d $app ]]; then
    expected=$(jq -r .build "$share/hammerspoon2.json" 2>/dev/null || true)
    actual=$(hs2_build)
    if [[ -n $expected && $actual == "$expected" ]]; then
      ok "$app_name build $actual matches the pinned build"
    else
      fail "$app_name build ${actual:-unknown} is not the pinned build ${expected:-unknown}; run: brew reinstall --cask $tap/$hs2_cask"
    fi
  else
    fail "$app_name is not installed at $app; run: brew install --cask $tap/$hs2_cask"
  fi
  if hs2_running; then ok "$app_name is running"; else fail "$app_name is not running; run: open -a '$app'"; fi
  if [[ $(config_path) == "$init" && $(setting hasCompletedOnboarding) == 1 ]]; then
    ok "$app_name is configured to load $init"
  else
    fail "$app_name settings do not point at $init; run: atelier install"
  fi
  if [[ $(setting dockMenuBehaviour) == menuBar ]]; then
    ok "$app_name shows its menu bar item only"
  else
    fail "$app_name Dock behaviour is not menuBar; run: atelier install"
  fi
  if [[ ! -f $init ]]; then
    fail "$init does not exist; run: atelier install"
  elif init_requires_atelier; then
    ok "$init requires $share"
  else
    fail "$init: could not find a require for $share; add: const atelier = require(\"$share\"); before atelier.start(...), or run atelier repair to back up this file and restore defaults"
  fi
  if login_item_present; then
    ok "$app_name is a login item"
  else
    fail "$app_name is not a login item; run: atelier install"
  fi
  if [[ -x $share/atelier-providers ]]; then
    if codesign --verify --strict "$share/atelier-providers" 2>/dev/null; then
      ok "atelier-providers signature is valid ($(codesign -dv "$share/atelier-providers" 2>&1 | sed -n 's/^Authority=//p' | head -1 || true))"
    else
      fail "atelier-providers signature is invalid; run: brew reinstall --cask $tap/$atelier_cask"
    fi
  fi
  if defaults read com.apple.ncprefs apps 2>/dev/null | grep -q "\"bundle-id\" = \"$bundle\""; then
    ok "$app_name has asked for notification permission; the answer is in System Settings > Notifications"
  else
    unknown "$app_name has not asked for notification permission yet; it asks when the defaults first start"
  fi
  if [[ $failed == 0 ]]; then echo 'Installation checks passed. Check the Atelier menu for runtime status.'; else echo 'Fix the FAIL lines above, then run atelier doctor again.'; fi
  return "$failed"
}

uninstall() {
  if login_item_present; then
    osascript -e "tell application \"System Events\" to delete every login item whose name is \"$app_name\"" > /dev/null \
      || echo 'Could not remove the login item; remove it in System Settings > General > Login Items.' >&2
  fi
  for key in configLocation hasCompletedOnboarding dockMenuBehaviour SUEnableAutomaticChecks; do
    defaults delete "$bundle" "$key" 2>/dev/null || true
  done
  echo "Removed the login item and Atelier's $app_name settings. Kept $init."
  echo "Remove the packages with: brew uninstall --cask $atelier_cask $hs2_cask"
}

case "${1:-}" in
  install) [[ $# == 1 ]] || die "usage: atelier install"; install ;;
  repair) [[ $# == 1 ]] || die "usage: atelier repair"; install true ;;
  doctor) doctor ;;
  uninstall) uninstall ;;
  version|--version) jq -r .version "$share/version.json" ;;
  --help|-h|help|'') usage; [[ ${1:-} ]] ;;
  *) usage >&2; exit 2 ;;
esac
