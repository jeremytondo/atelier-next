+            // The error is now owned by Swift. Leaving it on the context would
+            // make a later timer mistake it for its own callback failure.
+            context?.exception = nil
+            throw NSError(domain: "Hammerspoon.Configuration", code: 1,
+                          userInfo: [NSLocalizedDescriptionKey: "\(url.path): \(message)\n\(stack)"])
+        }
+        return result
