#!/bin/zsh
set -eu

prototype_dir="${0:A:h}/Prototypes/NativeWindowTilingPOC"
prototype_binary="$prototype_dir/.build/debug/space-control-prototype"

if [[ ! -x "$prototype_binary" ]]; then
    print -u2 'Build the prototype first, from the repository root:'
    print -u2 '  swift build --package-path Prototypes/NativeWindowTilingPOC'
    exit 1
fi

exec "$prototype_binary" "$@"
