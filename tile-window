#!/bin/zsh
set -eu

# Use the built binary so the countdown starts without compiling on each run.
probe_dir="${0:A:h}/Prototypes/NativeWindowTilingPOC"
probe_binary="$probe_dir/.build/debug/native-window-tiling-poc"

if (( $# == 0 )); then
    print 'Usage: ./tile-window left|right|top|bottom|top-left|top-right|bottom-left|bottom-right|fill|center|untile'
    print 'After starting, switch to your target window during the five-second countdown.'
    exit 0
fi

if [[ ! -x "$probe_binary" ]]; then
    print -u2 'Build the tester first, from the repository root:'
    print -u2 '  swift build --package-path Prototypes/NativeWindowTilingPOC'
    exit 1
fi

exec "$probe_binary" "$@" --focused-window
